# Copy to .env and fill in. .env is gitignored - never commit a real key.
OPENAI_API_KEY=sk-...
# Optional: USD per 1M tokens for gpt-5.6-luna (check the OpenAI pricing page), used for the Cost column
PRICE_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=
PRICE_CACHED_INPUT_PER_1M=
# Optional: default "none" (required by gpt-5.6-luna for function tools in Chat Completions)
REASONING_EFFORT=
